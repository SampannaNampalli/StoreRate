{
  "name": "store-rating-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + PostgreSQL API for the store rating platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:status": "node src/db/migrate.js --status",
    "db:reset": "node src/db/migrate.js --fresh",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:reset && npm run db:seed",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
