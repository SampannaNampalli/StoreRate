# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins. Must name them
# explicitly in production - "*" is rejected at boot.
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of this process. 0 for a direct
# connection. Set it to the real hop count when deploying behind a load
# balancer, or the rate limiter sees the proxy's IP for every caller.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
# Either set DATABASE_URL (what managed providers hand out)...
# DATABASE_URL=postgres://user:password@host:5432/store_ratings

# ...or the discrete variables below. DATABASE_URL wins if both are set.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=store_ratings

# TLS. Defaults to on when DATABASE_URL is set, off otherwise.
# Point PGSSLROOTCERT at your provider's CA bundle to verify the
# certificate properly; without it, set PGSSLMODE=no-verify.
# PGSSLMODE=require
# PGSSLROOTCERT=/etc/ssl/certs/provider-ca.pem
# DATABASE_SSL=true

# Pool and timeout tuning (defaults shown).
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONNECT_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------
# Auth
# ---------------------------------------------------------------
# REQUIRED in production - the process refuses to boot without it, and
# rejects anything under 32 characters or copied from this file.
# Generate one with:  openssl rand -base64 48
# In development, a local secret is generated into backend/.dev-secret.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Password hashing uses scrypt. Cost is the log2 of the N parameter;
# 15 means N=32768, roughly 32 MB and ~100 ms per hash.
# SCRYPT_COST_LOG2=15

# Only used to verify hashes created before the scrypt switch.
# BCRYPT_ROUNDS=10

# ---------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------
# Counters are per-process. Running more than one instance needs a
# shared store, or each instance grants the full budget on its own.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_MAX=20
# WRITE_RATE_LIMIT_MAX=60

# Turns rate limiting off for load tests and the smoke test. Ignored
# when NODE_ENV=production.
# RATE_LIMIT_DISABLED=false

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
# REQUEST_BODY_LIMIT=100kb
# SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------
# Seed data (used by `npm run db:seed`)
# ---------------------------------------------------------------
# The seed refuses to run with NODE_ENV=production, and refuses to
# truncate a database that already holds rows unless given --force.
SEED_ADMIN_EMAIL=admin@storerate.com
# Leave blank and the seed generates a strong password and prints it once.
SEED_ADMIN_PASSWORD=
